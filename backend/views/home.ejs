<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
    </style>
</head>
<body>
    <h1>URL Shortener</h1>

    <form action="/urls" method="POST">
        <label for="url">Enter Your URL</label>
        <input type="url" id="url" name="url" placeholder="https://xyz.com" required>
        <button type="submit">Generate</button>
    </form>

    <% if (locals.id) { %>
        <p>Short URL: <a href="http://localhost:8001/<%= id %>" target="_blank">http://localhost:8001/<%= id %></a></p>
    <% } %>

    <% if (locals.urls && locals.urls.length > 0) { %>
        <h2>Analytics Table</h2>
        <table>
            <thead>
                <tr>
                    <th>S.No</th>
                    <th>Short ID</th>
                    <th>Original URL</th>
                    <th>Total Clicks</th>
                    <th>Last Clicked</th>
                </tr>
            </thead>
            <tbody>
                <% urls.forEach((ur, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><a href="http://localhost:8001/<%= ur.shortId %>" target="_blank"><%= ur.shortId %></a></td>
                        <td><%= ur.redirectUrl %></td>
                        <td><%= ur.visitHistory ? ur.visitHistory.length : 0 %></td>
                        <td>
                            <% if (ur.visitHistory && ur.visitHistory.length > 0) { %>
                                <%= new Date(ur.visitHistory[ur.visitHistory.length - 1].timestamp).toLocaleString() %>
                            <% } else { %>
                                No clicks yet
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } %>
</body>
</html>